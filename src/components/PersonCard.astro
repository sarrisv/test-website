---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { resolvePath } from '@lib/pathUtils';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
---

<article class="card bg-base-100 shadow hover:shadow-lg transition-shadow">
  <div class="card-body p-6">
    <div class="flex items-center gap-5">
      <figure class="avatar flex-shrink-0">
        <div class="w-24 h-24 rounded-full ring ring-primary ring-offset-4">
          <Image 
            src={person.data.image} 
            alt={person.data.fullname} 
            class="object-cover"
            width={96}
            height={96}
          />
        </div>
      </figure>
      
      <div class="flex-1 min-w-0">
        <h3 class="font-bold text-xl">
          <a href={resolvePath(`/people/${person.data.id}`)} class="link link-hover">{person.data.fullname}</a>
        </h3>
        
        {person.data.department && (
          <p class="text-primary font-medium mb-2">{person.data.department}</p>
        )}
      </div>
    </div>
  </div>
</article>
