---
import Base from '@layouts/Base.astro';
import PageContainer from '@components/PageContainer.astro';
import PageHeader from '@components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets'; // Import Astro's Image component

// export async function getStaticPaths() {
  
//   return newsEntries.map(entry => ({
//     params: { id: entry.id }
//   }));
// }

// const { entry } = Astro.params;
// const { Content } = await entry.render();

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title}>
  <PageContainer width="narrow">
    <article class="py-10">
      <PageHeader 
        title={post.data.title} 
        subtitle={post.data.date.toDateString()} 
      />
      
      <Image 
        src={post.data.image} 
        alt={`Photo related to ${post.data.title}`}
        class="rounded-xl shadow-lg w-auto h-fit max-w-xl mx-auto block mb-12"
      />

      <div class="prose prose-lg max-w-none prose-a:link prose-a:link-primary">
        <Content />
      </div>
    </article>
  </PageContainer>
</Base>