---
import { marked } from 'marked';
import Base from '@layouts/Base.astro';
import PageContainer from '@components/PageContainer.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionTitle from '@components/SectionTitle.astro';
import { resolvePath } from '@lib/pathUtils';
import { getPersonInfo } from '@lib/personUtils';
import { getProjects, getPeople } from '@lib/dataProvider';

export async function getStaticPaths() {
  const [projects, people] = await Promise.all([getProjects(), getPeople()]);
  return projects
    .filter(project => project.data.link)
    .map(project => ({
      params: { id: project.data.id },
      props: { project, people }, // Pass people to avoid refetch
    }));
}

const { project, people } = Astro.props;
---

<Base title={`${project.data.title} | ADMT Lab`}>
  <PageContainer width="narrow">
    <PageHeader title={project.data.title} />

    <div class="prose prose-lg max-w-none prose-a:link prose-a:link-primary">
      <div class="mb-8">
        <SectionTitle title="Description" variant="primary" />
        <div set:html={marked.parse(project.data.description)} />
      </div>

      {project.data.team && (
        <div class="mb-12">
          <SectionTitle title="Team" variant="primary" />
          
          <div>
            {project.data.team.faculty && project.data.team.faculty.length > 0 && (
              <div class="mb-4">
                <h4 class="text-lg font-semibold text-base-content/90 mb-2">Faculty</h4>
                <ul class="list-disc list-inside space-y-1">
                  {project.data.team.faculty.map(member => {
                    const personInfo = getPersonInfo(member, people);
                    return (
                      <li>
                        {personInfo.found ? (
                          <a href={resolvePath(`/people/${member}`)} class="link link-primary">{personInfo.name}</a>
                        ) : (
                          <span class="text-base-content/80">{personInfo.name}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
            
            {project.data.team.collaborators && project.data.team.collaborators.length > 0 && (
              <div class="mb-4">
                <h4 class="text-lg font-semibold text-base-content/90 mb-2">Collaborators</h4>
                <ul class="list-disc list-inside space-y-1">
                  {project.data.team.collaborators.map(member => {
                    const personInfo = getPersonInfo(member, people);
                    return (
                      <li>
                        {personInfo.found ? (
                          <a href={resolvePath(`/people/${member}`)} class="link link-primary">{personInfo.name}</a>
                        ) : (
                          <span class="text-base-content/80">{personInfo.name}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}

            {project.data.team.gradStudents && project.data.team.gradStudents.length > 0 && (
              <div class="mb-4">
                <h4 class="text-lg font-semibold text-base-content/90 mb-2">Graduate Students</h4>
                <ul class="list-disc list-inside space-y-1">
                  {project.data.team.gradStudents.map(member => {
                    const personInfo = getPersonInfo(member, people);
                    return (
                      <li>
                        {personInfo.found ? (
                          <a href={resolvePath(`/people/${member}`)} class="link link-primary">{personInfo.name}</a>
                        ) : (
                          <span class="text-base-content/80">{personInfo.name}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}

            {project.data.team.ugradStudents && project.data.team.ugradStudents.length > 0 && (
              <div class="mb-4">
                <h4 class="text-lg font-semibold text-base-content/90 mb-2">Undergraduate Students</h4>
                <ul class="list-disc list-inside space-y-1">
                  {project.data.team.ugradStudents.map(member => {
                    const personInfo = getPersonInfo(member, people);
                    return (
                      <li>
                        {personInfo.found ? (
                          <a href={resolvePath(`/people/${member}`)} class="link link-primary">{personInfo.name}</a>
                        ) : (
                          <span class="text-base-content/80">{personInfo.name}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </div>
        </div>
      )}

      {project.data.grants && project.data.grants.length > 0 && (
        <div class="mb-8">
          <SectionTitle title="Grants" variant="primary" />
          <ul>
            {project.data.grants.map(grant => <li set:html={marked.parse(grant)} />)}
          </ul>
        </div>
      )}

      {project.data.links && project.data.links.length > 0 && (
        <div class="mb-8">
          <SectionTitle title="Links" variant="primary" />
          <ul>
            {project.data.links.map(link => (
              <li><a href={resolvePath(link.url)} target="_blank" rel="noopener noreferrer" class="link link-primary">{link.label}</a></li>
            ))}
          </ul>
        </div>
      )}

      {project.data.press && project.data.press.length > 0 && (
        <div class="mb-8">
          <SectionTitle title="Press Coverage" variant="primary" />
          <ul>
            {project.data.press.map(article => (
              <li><a href={resolvePath(article.url)} target="_blank" rel="noopener noreferrer" class="link link-primary">{article.label}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
    
  </PageContainer>
</Base>
