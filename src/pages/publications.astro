---
import Base from '@layouts/Base.astro';
import PubCard from '@components/PubCard.astro';
import PageContainer from '@components/PageContainer.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionTitle from '@components/SectionTitle.astro';
import { getPublications } from '@lib/pubUtils.js';

const publicationsByYear = await getPublications();
---

<Base title="Publications">
  <PageContainer>
    <PageHeader 
      title="Publications" 
      subtitle="Research publications from the ADMT Lab" 
    />

    <section class="sticky top-4 z-10 mb-12">
      <div class="relative">
        <label for="pubSearch" class="sr-only">Search publications</label>
        <input 
          type="text" 
          id="pubSearch" 
          placeholder="Search by title, author, venue, year..." 
          class="input input-bordered w-full pr-20 shadow-lg"
        />
        <button 
          type="button"
          id="clearSearch"
          class="btn btn-ghost btn-sm absolute right-2 top-1/2 transform -translate-y-1/2 opacity-0 transition-opacity"
          title="Clear search"
          aria-label="Clear search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="searchStatus" class="text-sm text-base-content/70 mt-2 hidden" aria-live="polite"></div>
    </section>

    <div id="pubList">
      {publicationsByYear.map(group => (
        <section class="year-group mb-12">
          <SectionTitle title={group.year.toString()} variant="primary" />
          <ul>
            {group.papers.map(paper => (
              <li>
                <PubCard paper={paper} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </PageContainer>

  <!-- Shared BibTeX Modal -->
  <dialog id="bibtexModal" class="modal">
    <div class="modal-box w-11/12 max-w-3xl">
      <h3 class="font-bold text-lg" aria-label="BibTeX Citation">BibTeX Citation</h3>
      <div class="relative">
        <pre class="bg-base-300 p-4 mt-4 rounded text-xs overflow-x-auto whitespace-pre-wrap font-mono"><code id="bibtexContent" class="language-bibtex"></code></pre>
        <button 
          id="copyBibtexBtn"
          class="btn btn-xs btn-outline absolute top-6 right-2" 
        >
          Copy
        </button>
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-outline">Close</button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>Close</button>
    </form>
  </dialog>

  <script>
    import { initPublicationSearch } from '@lib/publicationSearch.js';
    initPublicationSearch();
  </script>
</Base>
