---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageContainer from '../components/PageContainer.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const recentNews = allNews
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

import labLogo from '../assets/logo-circle.svg';
---

<Base title="Home | ADMT Lab">
  <PageContainer>
    <!-- 1. Header Section -->
    <header class="text-center py-12 border-b border-base-300">
      <h1 class="text-4xl md:text-5xl font-black text-primary mb-2">
        Advanced Data Management Technologies Laboratory
      </h1>
      <p class="text-xl md:text-2xl font-medium text-base-content/70">
        Home of Database Group @ Pitt
      </p>
    </header>

  <!-- 2. About/Logo Section -->
  <section class="py-12 flex flex-col-reverse lg:flex-row items-center gap-12">
    <!-- Text Column -->
    <div class="lg:w-2/3 prose prose-lg max-w-none">
      <SectionTitle title="Our Research" variant="primary" size="large" />
      <p class="text-justify leading-relaxed">
        The Advanced Data Management Technologies Laboratory at the University of Pittsburgh, founded in 1996, is co-directed by Panos K. Chrysanthis and Alexandros Labrinidis. Research projects cover the entire data life cycle, from data acquisition, to data processing, exploration and analysis, to data dissemination and the approach taken is user-centric: emphasis is given on Quality of Service (QoS) and Quality of Data (QoD) returned to the users, and on controlling the trade-off between QoS and QoD, in a way that is prescribed by the users.

        Our research projects cover the entire data life-cycle, contributing to the understanding of data management and the development of context-aware algorithms, protocols and prototypes. Several of our projects are interdisciplinary and collaborative with groups within and outside Pitt and abroad.

        Their underlying philosophy is to exploit semantics of the data and cross-layer optimizations in hardware-software stacks to offer the best personalized user experience.
      </p>
    </div>

    <!-- Logo Column -->
    <div class="lg:w-1/3 flex justify-center">
      <Image src={labLogo} alt="ADMT Logo" loading="eager"/>
    </div>
  </section>

  <!-- 3. News Feed Section -->
  <section class="py-12">
    <div class="flex justify-between items-end mb-8">
      <SectionTitle title="Recent News" variant="primary" size="large" spacing="tight" />
      <a href="/news" class="link link-primary font-semibold">View All News →</a>
    </div>

    <div class="space-y-4">
      {recentNews.map((story) => (
        <a 
          href={`/news/${story.id}`} 
          class="block bg-base-100 p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow border border-base-200 group"
        >
          <div class="flex flex-col md:flex-row md:items-center gap-4">
            <div class="flex-grow">
              <div class="whitespace-nowrap mb-1">
                <span class="text-sm text-base-content/60">
                  {story.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </span>
              </div>
              
              <h3 class="text-xl font-bold group-hover:text-primary transition-colors">
                {story.data.title}
              </h3>
            </div>

            <div class="ml-auto hidden md:block">
               <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
    </section>
  </PageContainer>
</Base>