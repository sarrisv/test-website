---
import Base from '@layouts/Base.astro';
import PageContainer from '@components/PageContainer.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionTitle from '@components/SectionTitle.astro';
import CourseCard from '@components/CourseCard.astro';
import { getCourses, getPeople } from '@lib/dataProvider';

const courses = await getCourses();
const people = await getPeople();

const currentCourses = courses.filter(course => course.data.status === 'current');
const previousCourses = courses.filter(course => course.data.status === 'previous');
---

<Base title="Courses | ADMT Lab">
  <PageContainer width="narrow">
    <PageHeader 
      title="Courses" 
      subtitle="Courses taught by ADMT Lab faculty members" 
    />

    {currentCourses.length > 0 && (
      <section class="mb-12">
        <SectionTitle title="Current Courses" variant="primary" />
        <ul class="grid gap-6">
          {currentCourses.map(course => (
            <li>
              <CourseCard course={course} people={people} isCurrent={true} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {previousCourses.length > 0 && (
      <section class="mb-12">
        <SectionTitle title="Previous Courses" variant="primary" />
        <ul class="grid gap-6">
          {previousCourses.map(course => (
            <li>
              <CourseCard course={course} people={people} isCurrent={false} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </PageContainer>
</Base>
